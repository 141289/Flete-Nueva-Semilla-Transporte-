                        <!-- Financial Columns (Exclusively Victoria & Mauricio) -->
                        ${admin ? `
                            <td class="py-3 px-4 font-semibold font-mono text-slate-800 whitespace-nowrap">
                                $ ${(item.tariff || 0).toLocaleString('es-AR', {minimumFractionDigits: 2})}
