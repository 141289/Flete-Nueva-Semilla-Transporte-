```html
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva Semilla Transporte S.A. - Control de Fletes</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col antialiased">

    <!-- Top Navigation Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                
                <!-- Logo & Brand Title -->
                <div class="flex items-center space-x-3">
                    <div class="relative group cursor-pointer" onclick="document.getElementById('logoInput').click()">
                        <div id="logoContainer" class="w-12 h-12 rounded-xl bg-brand-800 text-white flex items-center justify-center font-bold text-xl overflow-hidden shadow-inner border border-brand-600 transition-transform hover:scale-105">
                            <i class="fa-solid fa-truck-mutton text-2xl" id="defaultLogoIcon"></i>
                            <img id="customLogoImg" class="hidden w-full h-full object-cover" alt="Logo Nueva Semilla">
                        </div>
                        <div class="absolute inset-0 bg-black/40 rounded-xl flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <i class="fa-solid fa-camera text-white text-xs"></i>
                        </div>
                    </div>
                    <input type="file" id="logoInput" accept="image/*" class="hidden" onchange="handleLogoUpload(event)">
                    <div>
                        <h1 class="text-lg sm:text-xl font-bold text-brand-900 tracking-tight leading-tight flex items-center gap-2">
                            <span>Nueva Semilla Transporte S.A.</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-brand-100 text-brand-800 border border-brand-200">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse mr-1.5"></span> En Línea
                            </span>
                        </h1>
                        <p class="text-xs text-slate-500">Control de Camión y Fletes</p>
                    </div>
                </div>

                <!-- User Selector & Status -->
                <div class="flex items-center justify-between md:justify-end gap-3 bg-slate-50 p-2 rounded-xl border border-slate-200">
                    <div class="flex items-center space-x-2">
                        <label for="currentUserSelect" class="text-xs font-semibold text-slate-600 uppercase tracking-wider pl-1">
                            <i class="fa-solid fa-user-circle text-brand-700 mr-1"></i>Usuario:
                        </label>
                        <select id="currentUserSelect" onchange="promptUserSwitch(this.value)" class="bg-white text-slate-800 text-sm font-semibold rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 px-3 py-1.5 shadow-sm outline-none cursor-pointer">
                            <option value="Cristian">Cristian</option>
                            <option value="Franco">Franco</option>
                            <option value="Judit">Judit</option>
                            <option value="Mauricio">Mauricio</option>
                            <option value="Victoria">Victoria</option>
                        </select>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- KPI Metrics Summary Cards (Visible only to Victoria and Mauricio) -->
        <div id="kpiContainer" class="hidden grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">Total Kilos</p>
                    <h3 id="kpiTotalKilos" class="text-xl sm:text-2xl font-bold text-slate-800 mt-1">0 Kg</h3>
                    <p id="kpiTotalViajes" class="text-[11px] text-slate-400 mt-0.5">0 viajes de camión</p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-slate-100 text-slate-700 rounded-xl flex items-center justify-center text-lg sm:text-xl shrink-0">
                    <i class="fa-solid fa-weight-hanging"></i>
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-blue-100 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-blue-600 uppercase tracking-wider">Monto Total</p>
                    <h3 id="kpiMontoTotal" class="text-xl sm:text-2xl font-bold text-blue-700 mt-1">$ 0</h3>
                    <p class="text-[11px] text-blue-500 mt-0.5">Valor total fletes</p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-lg sm:text-xl shrink-0">
                    <i class="fa-solid fa-calculator"></i>
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-emerald-100 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-emerald-600 uppercase tracking-wider">Total Pagado</p>
                    <h3 id="kpiPagados" class="text-xl sm:text-2xl font-bold text-emerald-700 mt-1">$ 0</h3>
                    <p id="kpiPagadosCount" class="text-[11px] text-emerald-500 mt-0.5">0 fletes pagados</p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-lg sm:text-xl shrink-0">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-amber-100 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-amber-600 uppercase tracking-wider">Pendiente Pago</p>
                    <h3 id="kpiPendientes" class="text-xl sm:text-2xl font-bold text-amber-700 mt-1">$ 0</h3>
                    <p id="kpiPendientesCount" class="text-[11px] text-amber-500 mt-0.5">0 fletes pendientes</p>
                </div>
                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-lg sm:text-xl shrink-0">
                    <i class="fa-solid fa-clock"></i>
                </div>
            </div>
        </div>

        <!-- Action Bar & Filter Options -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 space-y-4">
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                
                <button onclick="openFreightModal()" class="bg-brand-700 hover:bg-brand-800 text-white font-medium px-5 py-2.5 rounded-xl shadow-md transition-all flex items-center justify-center gap-2 text-sm active:scale-95">
                    <i class="fa-solid fa-plus text-base"></i>
                    <span>Cargar Nuevo Flete</span>
                </button>

                <div class="flex flex-col sm:flex-row items-center gap-2">
                    <!-- Export to Excel Button -->
                    <button onclick="exportToExcel()" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-4 py-2.5 rounded-xl shadow border border-emerald-700 transition flex items-center justify-center gap-2 text-sm active:scale-95">
                        <i class="fa-solid fa-file-excel text-base"></i>
                        <span>Exportar a Excel</span>
                    </button>

                    <!-- Search Input -->
                    <div class="relative w-full sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="searchInput" oninput="filterFreights()" placeholder="Buscar producto, viaje, remito..." class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:ring-2 focus:ring-brand-500 focus:bg-white outline-none transition">
                    </div>
                </div>

            </div>

            <!-- Advanced Filter Bar -->
            <div class="pt-3 border-t border-slate-100 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 text-sm">
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Movimiento</label>
                    <select id="filterMovement" onchange="filterFreights()" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-brand-500 outline-none">
                        <option value="ALL">Todos (Entrada/Salida)</option>
                        <option value="ENTRADA">📥 Entrada</option>
                        <option value="SALIDA">📤 Salida</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Fecha Desde</label>
                    <input type="date" id="filterDateFrom" onchange="filterFreights()" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-brand-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Fecha Hasta</label>
                    <input type="date" id="filterDateTo" onchange="filterFreights()" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-brand-500 outline-none">
                </div>
                <div id="filterStatusContainer" class="hidden">
                    <label class="block text-xs font-semibold text-slate-500 mb-1">Estado Pago</label>
                    <select id="filterPaymentStatus" onchange="filterFreights()" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-xs focus:ring-2 focus:ring-brand-500 outline-none">
                        <option value="ALL">Todos los Estados</option>
                        <option value="PAGADO">Pagados</option>
                        <option value="PENDIENTE">Pendientes</option>
                    </select>
                </div>
                <div class="col-span-2 sm:col-span-1 flex items-end">
                    <button onclick="clearFilters()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium p-2 rounded-lg text-xs transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-filter-circle-xmark"></i>
                        <span>Limpiar Filtros</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Table View for Desktop / Card View for Mobile -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <!-- Loading Indicator -->
            <div id="loadingSpinner" class="p-8 text-center text-slate-500 space-y-2">
                <i class="fa-solid fa-spinner fa-spin text-3xl text-brand-600"></i>
                <p class="text-sm font-medium">Sincronizando fletes de Nueva Semilla en tiempo real...</p>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden p-12 text-center space-y-3">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto text-slate-400 text-2xl">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                </div>
                <h3 class="text-base font-semibold text-slate-700">No hay fletes registrados</h3>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">Comienza agregando un nuevo flete o ajusta los filtros de búsqueda para ver los datos.</p>
            </div>

            <!-- Desktop Table View -->
            <div class="hidden lg:block overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse" id="freightTable">
                    <thead>
                        <tr class="bg-slate-50 text-slate-500 text-xs font-semibold uppercase tracking-wider border-b border-slate-200">
                            <th class="py-3 px-4">Fecha/Hora</th>
                            <th class="py-3 px-4">Tipo Movimiento</th>
                            <th class="py-3 px-4">N° Viaje</th>
                            <th class="py-3 px-4">Producto</th>
                            <th class="py-3 px-4">Kilos</th>
                            <th class="py-3 px-4">Factura/Remito</th>
                            <th class="py-3 px-4 admin-col hidden">Tarifa ($)</th>
                            <th class="py-3 px-4 admin-col hidden">Estado Pago</th>
                            <th class="py-3 px-4">Cargado Por</th>
                            <th class="py-3 px-4">Comentario</th>
                            <th class="py-3 px-4 text-right">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="divide-y divide-slate-100 text-sm">
                        <!-- Dynamic Content Inserted Here -->
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div id="cardContainer" class="block lg:hidden divide-y divide-slate-100">
                <!-- Dynamic Content Inserted Here -->
            </div>
        </div>

    </main>

    <!-- Modal Form for Create / Edit Freight -->
    <div id="freightModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden transition-opacity duration-200">
        <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full overflow-hidden flex flex-col max-h-[90vh]">
            
            <!-- Modal Header -->
            <div class="bg-brand-900 text-white px-6 py-4 flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-truck-moving text-brand-500"></i>
                    <h3 id="modalTitle" class="font-bold text-base">Cargar Nuevo Flete</h3>
                </div>
                <button onclick="closeFreightModal()" class="text-slate-300 hover:text-white rounded-lg p-1 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Modal Form Body -->
            <form id="freightForm" onsubmit="handleFormSubmit(event)" class="p-6 overflow-y-auto custom-scrollbar space-y-4">
                <input type="hidden" id="freightId">

                <!-- Movement Type Radio/Selector -->
                <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Marcar Entrada o Salida *</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="flex items-center justify-center p-2.5 bg-white border-2 border-emerald-200 rounded-xl cursor-pointer hover:bg-emerald-50 transition has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50 shadow-sm">
                            <input type="radio" name="movementType" value="ENTRADA" checked class="w-4 h-4 text-emerald-600 focus:ring-emerald-500">
                            <span class="ml-2 text-xs font-bold text-emerald-900 flex items-center gap-1.5">
                                <i class="fa-solid fa-circle-down text-emerald-600"></i> ENTRADA
                            </span>
                        </label>
                        <label class="flex items-center justify-center p-2.5 bg-white border-2 border-blue-200 rounded-xl cursor-pointer hover:bg-blue-50 transition has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 shadow-sm">
                            <input type="radio" name="movementType" value="SALIDA" class="w-4 h-4 text-blue-600 focus:ring-blue-500">
                            <span class="ml-2 text-xs font-bold text-blue-900 flex items-center gap-1.5">
                                <i class="fa-solid fa-circle-up text-blue-600"></i> SALIDA
                            </span>
                        </label>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Fecha *</label>
                        <input type="date" id="formDate" required class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Hora *</label>
                        <input type="time" id="formTime" required class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">N° de Viaje *</label>
                        <input type="text" id="formTripNumber" placeholder="Ej. 1042" required class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">N° Factura / Remito</label>
                        <input type="text" id="formInvoiceNumber" placeholder="Ej. 0001-000452" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Producto / Carga *</label>
                        <input type="text" id="formProduct" placeholder="Ej. Soja, Maíz, Semilla..." required class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">Kilos (Opcional)</label>
                        <input type="number" id="formKilos" step="1" placeholder="Ej. 30000" class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Cargado Por</label>
                    <input type="text" id="formCreatedBy" readonly class="w-full bg-slate-100 border border-slate-200 text-slate-500 rounded-lg p-2 text-sm cursor-not-allowed font-medium">
                </div>

                <!-- Tariff & Payment Status (EXCLUSIVELY VISIBLE TO MAURICIO & VICTORIA) -->
                <div id="adminFormSection" class="hidden p-3.5 bg-amber-50/80 border border-amber-200 rounded-xl space-y-3">
                    <div class="flex items-center justify-between border-b border-amber-200/60 pb-1.5">
                        <label class="text-xs font-bold text-amber-900 flex items-center gap-1.5">
                            <i class="fa-solid fa-coins text-amber-600"></i>
                            Gestión Financiera
                        </label>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tarifa / Monto ($)</label>
                            <input type="number" id="formTariff" step="0.01" placeholder="$ 0.00" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none font-semibold text-slate-800">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Estado de Pago</label>
                            <select id="formPaymentStatus" class="w-full bg-white border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none font-semibold">
                                <option value="PENDIENTE" class="text-amber-700 font-medium">⏳ PENDIENTE</option>
                                <option value="PAGADO" class="text-emerald-700 font-medium">✅ PAGADO</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Detalle o Comentarios</label>
                    <textarea id="formComments" rows="2" placeholder="Información adicional del viaje..." class="w-full border border-slate-300 rounded-lg p-2 text-sm focus:ring-2 focus:ring-brand-500 outline-none"></textarea>
                </div>

                <!-- Modal Actions -->
                <div class="pt-3 border-t border-slate-100 flex items-center justify-end space-x-3">
                    <button type="button" onclick="closeFreightModal()" class="px-4 py-2 border border-slate-300 rounded-xl text-slate-700 hover:bg-slate-50 font-medium text-sm transition">
                        Cancelar
                    </button>
                    <button type="submit" id="saveButton" class="px-5 py-2 bg-brand-700 hover:bg-brand-800 text-white rounded-xl font-medium text-sm shadow-md transition flex items-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Guardar Flete</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Password Modal -->
    <div id="passwordModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 space-y-4">
            <div class="text-center space-y-1">
                <div class="w-12 h-12 bg-amber-100 text-amber-700 rounded-full flex items-center justify-center mx-auto text-xl">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h3 class="font-bold text-lg text-slate-800">Acceso Administrador</h3>
                <p class="text-xs text-slate-500">Ingrese la contraseña para cambiar a <span id="pwdTargetUser" class="font-bold text-slate-700"></span></p>
            </div>
            
            <form onsubmit="verifyPassword(event)" class="space-y-3">
                <div>
                    <input type="password" id="pwdInput" placeholder="Contraseña" required class="w-full text-center text-lg tracking-widest border border-slate-300 rounded-xl p-2.5 focus:ring-2 focus:ring-brand-500 outline-none">
                </div>
                <div class="flex gap-2">
                    <button type="button" onclick="cancelUserSwitch()" class="w-1/2 py-2 border border-slate-300 rounded-xl text-slate-600 font-medium text-sm hover:bg-slate-50 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="w-1/2 py-2 bg-brand-700 hover:bg-brand-800 text-white font-medium text-sm rounded-xl transition shadow">
                        Ingresar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white px-4 py-3 rounded-xl shadow-lg flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-300 z-50">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
        <span id="toastMessage" class="text-sm font-medium">Operación realizada con éxito</span>
    </div>

    <!-- Firebase SDK Modules -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { 
            getAuth, 
            signInAnonymously, 
            signInWithCustomToken, 
            onAuthStateChanged 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { 
            getFirestore, 
            collection, 
            doc, 
            addDoc, 
            updateDoc, 
            deleteDoc, 
            onSnapshot 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global state and app configurations
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'nueva-semilla-fletes';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "demo-api-key",
            authDomain: "demo-app.firebaseapp.com",
            projectId: "demo-app",
            storageBucket: "demo-app.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:demo"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        let currentUser = 'Cristian';
        let previousUser = 'Cristian';
        let pendingUser = null;
        let freightsData = [];
        let authUser = null;

        // Passwords for privileged users (Judit, Victoria, Mauricio)
        const ADMIN_PASSWORDS = {
            'Victoria': '1',
            'Mauricio': '1',
            'Judit': '1'
        };

        // Initialize Authentication
        async function initAuth() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.error("Error signing in:", err);
            }
        }

        onAuthStateChanged(auth, (user) => {
            if (user) {
                authUser = user;
                setupRealtimeListener();
            }
        });

        // Setup Firestore listener for public collection
        function setupRealtimeListener() {
            if (!authUser) return;

            const freightsCollection = collection(db, 'artifacts', appId, 'public', 'data', 'freights');

            onSnapshot(freightsCollection, (snapshot) => {
                freightsData = snapshot.docs.map(doc => ({
                    id: doc.id,
                    ...doc.data()
                }));

                // Sort by date and time descending
                freightsData.sort((a, b) => {
                    const dateTimeA = new Date(`${a.date}T${a.time}`);
                    const dateTimeB = new Date(`${b.date}T${b.time}`);
                    return dateTimeB - dateTimeA;
                });

                document.getElementById('loadingSpinner').classList.add('hidden');
                renderFreights();
            }, (error) => {
                console.error("Firestore Error:", error);
                showToast("Error de conexión con la base de datos.", "error");
            });
        }

        // Check if user is Admin (Victoria, Mauricio, or Judit)
        function isAdmin(user = currentUser) {
            const u = user.toLowerCase();
            return u.includes('victoria') || u.includes('mauricio') || u.includes('judit');
        }

        // Password switch logic
        window.promptUserSwitch = function(targetUser) {
            if (ADMIN_PASSWORDS[targetUser]) {
                pendingUser = targetUser;
                document.getElementById('pwdTargetUser').textContent = targetUser;
                document.getElementById('pwdInput').value = '';
                document.getElementById('passwordModal').classList.remove('hidden');
                document.getElementById('pwdInput').focus();
            } else {
                currentUser = targetUser;
                previousUser = targetUser;
                applyUserPermissions();
            }
        };

        window.verifyPassword = function(e) {
            e.preventDefault();
            const pwd = document.getElementById('pwdInput').value;
            if (pwd === ADMIN_PASSWORDS[pendingUser]) {
                currentUser = pendingUser;
                previousUser = pendingUser;
                document.getElementById('passwordModal').classList.add('hidden');
                applyUserPermissions();
                showToast(`Sesión iniciada como ${currentUser}`);
            } else {
                showToast("Contraseña incorrecta", "error");
            }
        };

        window.cancelUserSwitch = function() {
            document.getElementById('passwordModal').classList.add('hidden');
            document.getElementById('currentUserSelect').value = previousUser;
        };

        // Apply visual permissions based on active role
        function applyUserPermissions() {
            const admin = isAdmin();
            const kpiContainer = document.getElementById('kpiContainer');
            const filterStatusContainer = document.getElementById('filterStatusContainer');

            if (admin) {
                kpiContainer.classList.remove('hidden');
                filterStatusContainer.classList.remove('hidden');
            } else {
                kpiContainer.classList.add('hidden');
                filterStatusContainer.classList.add('hidden');
            }

            renderFreights();
        }

        // Open Modal Form
        window.openFreightModal = function(id = null) {
            const modal = document.getElementById('freightModal');
            const form = document.getElementById('freightForm');
            const createdByInput = document.getElementById('formCreatedBy');
            
            form.reset();
            document.getElementById('freightId').value = id || '';
            createdByInput.value = currentUser;

            const admin = isAdmin();
            const adminFormSection = document.getElementById('adminFormSection');
            
            if (admin) {
                adminFormSection.classList.remove('hidden');
            } else {
                adminFormSection.classList.add('hidden');
            }

            if (id) {
                // Editing existing record
                const item = freightsData.find(f => f.id === id);
                if (item) {
                    document.getElementById('modalTitle').textContent = "Editar Registro de Flete";
                    
                    // Set radio movement type
                    const movementRadios = document.getElementsByName('movementType');
                    for (let r of movementRadios) {
                        r.checked = (r.value === (item.movementType || 'ENTRADA'));
                    }

                    document.getElementById('formDate').value = item.date || '';
                    document.getElementById('formTime').value = item.time || '';
                    document.getElementById('formTripNumber').value = item.tripNumber || '';
                    document.getElementById('formInvoiceNumber').value = item.invoiceNumber || '';
                    document.getElementById('formProduct').value = item.product || '';
                    document.getElementById('formKilos').value = item.kilos || '';
                    document.getElementById('formCreatedBy').value = item.createdBy || currentUser;
                    document.getElementById('formTariff').value = item.tariff || '';
                    document.getElementById('formPaymentStatus').value = item.paymentStatus || 'PENDIENTE';
                    document.getElementById('formComments').value = item.comments || '';
                }
            } else {
                // Creating new record
                document.getElementById('modalTitle').textContent = "Cargar Nuevo Flete";
                const now = new Date();
                document.getElementById('formDate').value = now.toISOString().split('T')[0];
                document.getElementById('formTime').value = now.toTimeString().slice(0,5);
                document.getElementById('formPaymentStatus').value = 'PENDIENTE';
                document.getElementById('formTariff').value = '';
            }

            modal.classList.remove('hidden');
        };

        window.closeFreightModal = function() {
            document.getElementById('freightModal').classList.add('hidden');
        };

        // Save / Update Freight Record
        window.handleFormSubmit = async function(e) {
            e.preventDefault();
            if (!authUser) return;

            const saveBtn = document.getElementById('saveButton');
            saveBtn.disabled = true;
            saveBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Guardando...`;

            const freightId = document.getElementById('freightId').value;
            
            // Get selected radio
            let selectedMovement = 'ENTRADA';
            const movementRadios = document.getElementsByName('movementType');
            for (let r of movementRadios) {
                if (r.checked) selectedMovement = r.value;
            }

            const data = {
                movementType: selectedMovement,
                date: document.getElementById('formDate').value,
                time: document.getElementById('formTime').value,
                tripNumber: document.getElementById('formTripNumber').value.trim(),
                invoiceNumber: document.getElementById('formInvoiceNumber').value.trim(),
                product: document.getElementById('formProduct').value.trim(),
                kilos: parseFloat(document.getElementById('formKilos').value) || 0,
                createdBy: document.getElementById('formCreatedBy').value,
                comments: document.getElementById('formComments').value.trim(),
                updatedAt: new Date().toISOString()
            };

            // Only update tariff/paymentStatus if current user is Admin
            if (isAdmin()) {
                data.tariff = parseFloat(document.getElementById('formTariff').value) || 0;
                data.paymentStatus = document.getElementById('formPaymentStatus').value;
            }

            try {
                if (freightId) {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'freights', freightId);
                    await updateDoc(docRef, data);
                    showToast("Flete actualizado correctamente");
                } else {
                    if (!isAdmin()) {
                        data.tariff = 0;
                        data.paymentStatus = 'PENDIENTE';
                    }
                    data.createdAt = new Date().toISOString();
                    const freightsCollection = collection(db, 'artifacts', appId, 'public', 'data', 'freights');
                    await addDoc(freightsCollection, data);
                    showToast("Nuevo flete registrado con éxito");
                }
                closeFreightModal();
            } catch (error) {
                console.error("Error saving document:", error);
                showToast("Error al guardar el flete", "error");
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = `<i class="fa-solid fa-floppy-disk"></i> <span>Guardar Flete</span>`;
            }
        };

        // Delete Freight Record
        window.deleteFreight = async function(id) {
            if (!confirm("¿Está seguro de que desea eliminar este registro de flete?")) return;
            if (!authUser) return;

            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'freights', id);
                await deleteDoc(docRef);
                showToast("Flete eliminado");
            } catch (err) {
                console.error("Error deleting:", err);
                showToast("No se pudo eliminar el registro", "error");
            }
        };

        // Filter and Search Logic
        window.filterFreights = function() {
            renderFreights();
        };

        window.clearFilters = function() {
            document.getElementById('searchInput').value = '';
            document.getElementById('filterMovement').value = 'ALL';
            document.getElementById('filterDateFrom').value = '';
            document.getElementById('filterDateTo').value = '';
            document.getElementById('filterPaymentStatus').value = 'ALL';
            renderFreights();
        };

        function getFilteredData() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const movement = document.getElementById('filterMovement').value;
            const dateFrom = document.getElementById('filterDateFrom').value;
            const dateTo = document.getElementById('filterDateTo').value;
            const status = document.getElementById('filterPaymentStatus').value;

            return freightsData.filter(item => {
                const matchesMovement = movement === 'ALL' || (item.movementType || 'ENTRADA') === movement;

                const matchesSearch = !search || 
                    (item.product && item.product.toLowerCase().includes(search)) ||
                    (item.tripNumber && item.tripNumber.toLowerCase().includes(search)) ||
                    (item.invoiceNumber && item.invoiceNumber.toLowerCase().includes(search)) ||
                    (item.createdBy && item.createdBy.toLowerCase().includes(search));

                const matchesDateFrom = !dateFrom || item.date >= dateFrom;
                const matchesDateTo = !dateTo || item.date <= dateTo;
                const matchesStatus = status === 'ALL' || item.paymentStatus === status;

                return matchesMovement && matchesSearch && matchesDateFrom && matchesDateTo && matchesStatus;
            });
        }

        // Export to Excel Function
        window.exportToExcel = function() {
            const dataToExport = getFilteredData();
            if (dataToExport.length === 0) {
                showToast("No hay datos para exportar con los filtros actuales", "error");
                return;
            }

            const admin = isAdmin();

            const formattedData = dataToExport.map(item => {
                const row = {
                    "Fecha": formatDate(item.date),
                    "Hora": item.time || '',
                    "Movimiento": item.movementType || 'ENTRADA',
                    "N° Viaje": item.tripNumber || '',
                    "Producto": item.product || '',
                    "Kilos": item.kilos || 0,
                    "N° Factura / Remito": item.invoiceNumber || '',
                    "Cargado Por": item.createdBy || ''
                };

                // Exclusively include financial columns for Victoria and Mauricio
                if (admin) {
                    row["Tarifa ($)"] = item.tariff || 0;
                    row["Estado Pago"] = item.paymentStatus || 'PENDIENTE';
                }

                row["Detalle / Comentario"] = item.comments || '';
                return row;
            });

            const worksheet = XLSX.utils.json_to_sheet(formattedData);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "Fletes");

            const max_cols = Object.keys(formattedData[0]).map(key => ({ wch: Math.max(key.length + 3, 15) }));
            worksheet['!cols'] = max_cols;

            const fileName = `Control_Fletes_NuevaSemilla_${new Date().toISOString().slice(0,10)}.xlsx`;
            XLSX.writeFile(workbook, fileName);
            showToast("Planilla Excel generada con éxito");
        };

        // Render Functions
        function renderFreights() {
            const items = getFilteredData();
            const tableBody = document.getElementById('tableBody');
            const cardContainer = document.getElementById('cardContainer');
            const emptyState = document.getElementById('emptyState');
