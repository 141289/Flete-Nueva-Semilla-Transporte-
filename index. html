                        </div>
                    </div>
                `;
            }).join('');
        }

        function updateKPIs(items) {
            const totalKilos = items.reduce((acc, curr) => acc + (parseFloat(curr.kilos) || 0), 0);
            const totalMonto = items.reduce((acc, curr) => acc + (parseFloat(curr.tariff) || 0), 0);
            
            const pagadosItems = items.filter(f => f.paymentStatus === 'PAGADO');
            const totalPagado = pagadosItems.reduce((acc, curr) => acc + (parseFloat(curr.tariff) || 0), 0);

            const pendientesItems = items.filter(f => f.paymentStatus !== 'PAGADO');
            const totalPendiente = pendientesItems.reduce((acc, curr) => acc + (parseFloat(curr.tariff) || 0), 0);

            document.getElementById('kpiTotalKilos').textContent = `${totalKilos.toLocaleString('es-AR')} kg`;
            document.getElementById('kpiTotalViajes').textContent = `${items.length} viajes registrados`;

            document.getElementById('kpiMontoTotal').textContent = `$ ${totalMonto.toLocaleString('es-AR', {minimumFractionDigits: 0})}`;
            document.getElementById('kpiPagados').textContent = `$ ${totalPagado.toLocaleString('es-AR', {minimumFractionDigits: 0})}`;
            document.getElementById('kpiPagadosCount').textContent = `${pagadosItems.length} fletes pagados`;

            document.getElementById('kpiPendientes').textContent = `$ ${totalPendiente.toLocaleString('es-AR', {minimumFractionDigits: 0})}`;
            document.getElementById('kpiPendientesCount').textContent = `${pendientesItems.length} fletes pendientes`;
        }

        // Custom Logo Upload Handler
        window.handleLogoUpload = function(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const customLogo = document.getElementById('customLogoImg');
                    const defaultIcon = document.getElementById('defaultLogoIcon');
                    customLogo.src = e.target.result;
                    customLogo.classList.remove('hidden');
                    defaultIcon.classList.add('hidden');
                };
                reader.readAsDataURL(file);
            }
        };

        // Utility: Toast Notification
        function showToast(message, type = "success") {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.textContent = message;
            if (type === "error") {
                toastIcon.className = "fa-solid fa-circle-xmark text-red-400 text-lg";
            } else {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-lg";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Utility: Format Date (YYYY-MM-DD -> DD/MM/YYYY)
        function formatDate(dateStr) {
            if (!dateStr) return '-';
            const parts = dateStr.split('-');
            if (parts.length === 3) {
                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            return dateStr;
        }

        // Initialize App
        window.addEventListener('DOMContentLoaded', () => {
            initAuth();
            applyUserPermissions();
        });
    </script>
</body>
</html>
