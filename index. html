<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Control de Fletes - Nueva Semilla Transporte S.A.</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- SheetJS para exportar a Excel -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Firebase SDKs -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js";
        import { getFirestore, collection, addDoc, getDocs, doc, updateDoc, deleteDoc, onSnapshot, query, orderBy } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-firestore.js";
        
        // Exponer Firebase globalmente para la aplicación
        window.firebaseModules = { initializeApp, getFirestore, collection, addDoc, getDocs, doc, updateDoc, deleteDoc, onSnapshot, query, orderBy };
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-emerald-50/50 min-h-screen text-slate-800">

    <!-- Modal de Autenticación para Usuarios Administradores -->
    <div id="authModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center hidden">
        <div class="bg-white rounded-2xl p-8 max-w-sm w-full mx-4 shadow-2xl border border-emerald-100">
            <div class="text-center mb-6">
                <div class="w-14 h-14 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl font-bold">🔒</div>
                <h3 class="text-xl font-bold text-slate-900" id="authModalTitle">Acceso Protegido</h3>
                <p class="text-sm text-slate-500 mt-1">Ingresá la contraseña asignada para continuar.</p>
            </div>
            <form id="authForm" onsubmit="handleAuthSubmit(event)">
                <input type="password" id="authPasswordInput" placeholder="Contraseña" required autofocus
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:border-emerald-600 outline-none text-center text-lg tracking-widest mb-4">
                <div id="authError" class="text-red-500 text-xs text-center mb-4 hidden font-medium">Contraseña incorrecta. Intentalo de nuevo.</div>
                <div class="flex gap-3">
                    <button type="button" onclick="closeAuthModal()" class="flex-1 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition">Cancelar</button>
                    <button type="submit" class="flex-1 px-4 py-2.5 rounded-xl bg-emerald-700 text-white font-medium hover:bg-emerald-800 transition shadow-md">Ingresar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Encabezado Institucional -->
    <header class="bg-emerald-900 text-white shadow-lg border-b-4 border-amber-500">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <!-- Logo Oficial -->
                <div class="bg-white p-1.5 rounded-xl shadow-md flex items-center justify-center">
                    <img src="1001762379.jpg" alt="Nueva Semilla de Chacabuco S.A." class="h-12 w-auto object-contain">
                </div>
                <div>
                    <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-white">Nueva Semilla Transporte S.A.</h1>
                    <p class="text-xs text-emerald-200 uppercase tracking-widest font-medium">Control de Fletes y Logística</p>
                </div>
            </div>

            <!-- Selector de Usuario Activo -->
            <div class="bg-emerald-800/80 px-4 py-2 rounded-xl border border-emerald-700 flex items-center gap-3 shadow-inner">
                <span class="text-xs text-emerald-200 font-medium">Usuario actual:</span>
                <select id="currentUserSelect" onchange="onUserChange(this.value)" class="bg-emerald-900 text-white font-semibold px-3 py-1.5 rounded-lg border border-emerald-600 focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer">
                    <option value="Cristian">Cristian</option>
                    <option value="Franco">Franco</option>
                    <option value="Judit">Judit</option>
                    <option value="Mauricio">Mauricio</option>
                    <option value="Victoria">Victoria</option>
                </select>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-6 space-y-6">

        <!-- Tarjetas de Métricas / KPIs Financieros (Solo para Mauricio, Judit y Victoria) -->
        <div id="financialKpis" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Viajes</p>
                    <h3 id="kpiTotalViajes" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                </div>
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl font-bold">🚛</div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Monto Total Fletes</p>
                    <h3 id="kpiMontoTotal" class="text-2xl font-bold text-emerald-700 mt-1">$ 0</h3>
                </div>
                <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-xl font-bold">💵</div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Pagado</p>
                    <h3 id="kpiTotalPagado" class="text-2xl font-bold text-blue-600 mt-1">$ 0</h3>
                </div>
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl font-bold">✅</div>
            </div>
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Pendiente</p>
                    <h3 id="kpiTotalPendiente" class="text-2xl font-bold text-orange-600 mt-1">$ 0</h3>
                </div>
                <div class="w-12 h-12 bg-orange-50 text-orange-600 rounded-xl flex items-center justify-center text-xl font-bold">⏳</div>
            </div>
        </div>

        <!-- Panel de Control: Formulario y Listado -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Formulario de Carga de Flete -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 lg:col-span-1">
                <div class="flex justify-between items-center mb-4">
                    <h2 id="formTitle" class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <span>📝</span> <span id="formTitleText">Cargar Nuevo Flete</span>
                    </h2>
                    <button id="cancelEditBtn" onclick="resetForm()" class="hidden text-xs text-red-500 font-semibold hover:underline">Cancelar edición</button>
                </div>

                <form id="fleteForm" onsubmit="saveFlete(event)" class="space-y-4">
                    <input type="hidden" id="fleteId">

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Fecha</label>
                            <input type="date" id="fecha" required class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Hora</label>
                            <input type="time" id="hora" required class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm">
                        </div>
                    </div>

                    <!-- Movimiento: Entrada o Salida -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Tipo de Movimiento</label>
                        <div class="flex gap-6 mt-1.5">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="movimiento" value="Salida" checked class="text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                <span class="text-sm font-medium text-slate-700">Salida 📤</span>
                            </label>
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="radio" name="movimiento" value="Entrada" class="text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                                <span class="text-sm font-medium text-slate-700">Entrada 📥</span>
                            </label>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">N° de Viaje</label>
                            <input type="text" id="nroViaje" placeholder="Ej: 00142" required class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">N° Factura / Remito</label>
                            <input type="text" id="nroFactura" placeholder="Ej: 0001-000452" class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Producto</label>
                        <input type="text" id="producto" placeholder="Ej: Maíz, Soja, Trigo..." required class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm">
                    </div>

                    <!-- Campos Administrativos (Solo para Victoria, Mauricio y Judit) -->
                    <div id="adminFieldsContainer" class="p-3.5 bg-emerald-50/70 rounded-xl border border-emerald-100 space-y-3">
                        <p class="text-xs font-bold text-emerald-800 uppercase tracking-wider">Gestión Administrativa</p>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Tarifa ($)</label>
                                <input type="number" id="tarifa" step="0.01" placeholder="0.00" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Estado de Pago</label>
                                <select id="estadoPago" class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm font-medium">
                                    <option value="Pendiente">Pendiente ⏳</option>
                                    <option value="Pagado">Pagado ✅</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Detalle / Comentarios</label>
                        <textarea id="comentario" rows="2" placeholder="Observaciones del viaje..." class="w-full px-3 py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm"></textarea>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-semibold py-2.5 px-4 rounded-xl transition shadow-md text-sm">
                        Guardar Flete
                    </button>
                </form>
            </div>

            <!-- Listado, Filtros y Vista Adaptada -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 lg:col-span-2 flex flex-col">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
                    <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                        <span>📋</span> Registro de Viajes
                    </h2>
                    
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <button onclick="exportToExcel()" class="bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition shadow-sm flex items-center gap-2 cursor-pointer w-full sm:w-auto justify-center">
                            <span>📊</span> Exportar a Excel
                        </button>
                    </div>
                </div>

                <!-- Barra de Filtros -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4 bg-slate-50 p-3.5 rounded-xl border border-slate-200">
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 mb-1 uppercase tracking-wider">Buscar (Viaje / Producto / Remito)</label>
                        <input type="text" id="filtroTexto" oninput="renderFletes()" placeholder="Escribí para buscar..." class="w-full px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs focus:outline-none focus:ring-1 focus:ring-emerald-600">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 mb-1 uppercase tracking-wider">Filtrar por Fecha</label>
                        <input type="date" id="filtroFecha" onchange="renderFletes()" class="w-full px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs focus:outline-none focus:ring-1 focus:ring-emerald-600">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 mb-1 uppercase tracking-wider">Movimiento</label>
                        <select id="filtroMovimiento" onchange="renderFletes()" class="w-full px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs focus:outline-none focus:ring-1 focus:ring-emerald-600">
                            <option value="">Todos los movimientos</option>
                            <option value="Salida">Salida 📤</option>
                            <option value="Entrada">Entrada 📥</option>
                        </select>
                    </div>
                </div>

                <!-- Tabla de Fletes (Computadora) -->
                <div class="hidden md:block overflow-x-auto flex-1 border border-slate-200 rounded-xl">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-emerald-900 text-white text-xs uppercase tracking-wider">
                                <th class="p-3 font-semibold">Fecha / Hora</th>
                                <th class="p-3 font-semibold">Tipo</th>
                                <th class="p-3 font-semibold">Viaje / Remito</th>
                                <th class="p-3 font-semibold">Producto</th>
                                <th class="p-3 font-semibold th-admin">Tarifa ($)</th>
                                <th class="p-3 font-semibold th-admin">Estado</th>
                                <th class="p-3 font-semibold">Usuario</th>
                                <th class="p-3 font-semibold text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="fletesTableBody" class="divide-y divide-slate-100 text-sm">
                            <!-- Se llena dinámicamente -->
                        </tbody>
                    </table>
                </div>

                <!-- Vista en Tarjetas (Celulares) -->
                <div id="fletesCardsContainer" class="md:hidden space-y-3 flex-1 overflow-y-auto">
                    <!-- Se llena dinámicamente -->
                </div>

                <!-- Mensaje sin registros -->
                <div id="noDataMessage" class="hidden text-center py-12 text-slate-400">
                    <p class="text-3xl mb-2">📭</p>
                    <p class="text-sm font-medium">No se encontraron registros de fletes.</p>
                </div>
            </div>

        </div>
    </main>

    <!-- Script de Base de Datos y Lógica Completa -->
    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyD-DummyKeyForNuevaSemillaTransporte987",
            authDomain: "nuevasemilla-fletes.firebaseapp.com",
            projectId: "nuevasemilla-fletes",
            storageBucket: "nuevasemilla-fletes.appspot.com",
            messagingSenderId: "123456789012",
            appId: "1:123456789012:web:abcdef1234567890"
        };

        let db, fletesCollection;
        let fletesData = [];
        let editingId = null;
        let pendingUserSelection = null;

        const adminUsers = ["Victoria", "Mauricio", "Judit"];

        window.addEventListener('DOMContentLoaded', async () => {
            const checkFirebase = setInterval(() => {
                if (window.firebaseModules) {
                    clearInterval(checkFirebase);
                    initFirebase();
                }
            }, 100);

            document.getElementById('fecha').valueAsDate = new Date();
            const now = new Date();
            document.getElementById('hora').value = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
            
            updateAdminView();
        });

        function initFirebase() {
            const { initializeApp, getFirestore, collection, onSnapshot, query, orderBy } = window.firebaseModules;
            const app = initializeApp(firebaseConfig);
            db = getFirestore(app);
            fletesCollection = collection(db, "fletes_nuevasemilla");

            const q = query(fletesCollection, orderBy("fecha", "desc"), orderBy("hora", "desc"));
            onSnapshot(q, (snapshot) => {
                fletesData = [];
                snapshot.forEach((docSnap) => {
                    fletesData.push({ id: docSnap.id, ...docSnap.data() });
                });
                renderFletes();
                updateKPIs();
            }, (error) => {
                console.warn("Modo local sin conexión con Firestore:", error);
                loadLocalStorageFallback();
            });
        }

        function loadLocalStorageFallback() {
            const local = localStorage.getItem('fletes_nuevasemilla_local');
            if (local) {
                fletesData = JSON.parse(local);
            } else {
                fletesData = [
                    { id: '1', fecha: '2026-10-30', hora: '08:30', movimiento: 'Salida', nroViaje: '1024', nroFactura: '0001-00125', producto: 'Soja', tarifa: 125000, estadoPago: 'Pendiente', usuario: 'Mauricio', comentario: 'Viaje a planta Ingredion' },
                    { id: '2', fecha: '2026-10-30', hora: '10:15', movimiento: 'Entrada', nroViaje: '1025', nroFactura: '0002-00412', producto: 'Maíz', tarifa: 98000, estadoPago: 'Pagado', usuario: 'Victoria', comentario: 'Descarga completa' }
                ];
            }
            renderFletes();
            updateKPIs();
        }

        function saveLocalStorageFallback() {
            localStorage.setItem('fletes_nuevasemilla_local', JSON.stringify(fletesData));
        }

        function onUserChange(selectedUser) {
            if (adminUsers.includes(selectedUser)) {
                pendingUserSelection = selectedUser;
                document.getElementById('authModalTitle').innerText = `Acceso para ${selectedUser}`;
                document.getElementById('authPasswordInput').value = '';
                document.getElementById('authError').classList.add('hidden');
                document.getElementById('authModal').classList.remove('hidden');
                document.getElementById('authPasswordInput').focus();
            } else {
                updateAdminView();
            }
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
            document.getElementById('currentUserSelect').value = 'Cristian';
            updateAdminView();
        }

        function handleAuthSubmit(event) {
            event.preventDefault();
            const pwd = document.getElementById('authPasswordInput').value;
            if (pwd === '1') {
                document.getElementById('authModal').classList.add('hidden');
                updateAdminView();
            } else {
                document.getElementById('authError').classList.remove('hidden');
            }
        }

        function getCurrentUser() {
            return document.getElementById('currentUserSelect').value;
        }

        function isAdmin() {
            return adminUsers.includes(getCurrentUser());
        }

        function updateAdminView() {
            const adminContainer = document.getElementById('adminFieldsContainer');
            const kpiContainer = document.getElementById('financialKpis');
            const thAdminElements = document.querySelectorAll('.th-admin');

            if (isAdmin()) {
                adminContainer.classList.remove('hidden');
                kpiContainer.classList.remove('hidden');
                thAdminElements.forEach(el => el.classList.remove('hidden'));
            } else {
                adminContainer.classList.add('hidden');
                kpiContainer.classList.add('hidden');
                thAdminElements.forEach(el => el.classList.add('hidden'));
            }
            renderFletes();
        }

        async function saveFlete(event) {
            event.preventDefault();
            const user = getCurrentUser();

            const fleteObj = {
                fecha: document.getElementById('fecha').value,
                hora: document.getElementById('hora').value,
                movimiento: document.querySelector('input[name="movimiento"]:checked').value,
                nroViaje: document.getElementById('nroViaje').value.trim(),
                nroFactura: document.getElementById('nroFactura').value.trim() || '-',
                producto: document.getElementById('producto').value.trim(),
                comentario: document.getElementById('comentario').value.trim() || '-',
                usuario: user,
                tarifa: isAdmin() ? parseFloat(document.getElementById('tarifa').value) || 0 : 0,
                estadoPago: isAdmin() ? document.getElementById('estadoPago').value : 'Pendiente'
            };

            try {
                if (window.firebaseModules && db) {
                    const { addDoc, collection, doc, updateDoc } = window.firebaseModules;
                    if (editingId) {
                        const docRef = doc(db, "fletes_nuevasemilla", editingId);
                        await updateDoc(docRef, fleteObj);
                    } else {
                        await addDoc(collection(db, "fletes_nuevasemilla"), fleteObj);
                    }
                } else {
                    if (editingId) {
                        const idx = fletesData.findIndex(f => f.id === editingId);
                        if (idx !== -1) fletesData[idx] = { id: editingId, ...fleteObj };
                    } else {
                        fleteObj.id = Date.now().toString();
                        fletesData.unshift(fleteObj);
                    }
                    saveLocalStorageFallback();
                    renderFletes();
                    updateKPIs();
                }

                resetForm();
            } catch (error) {
                console.error("Error al guardar:", error);
                alert("Hubo un error al guardar el flete. Intentalo nuevamente.");
            }
        }

        function resetForm() {
            document.getElementById('fleteForm').reset();
            document.getElementById('fleteId').value = '';
            editingId = null;
            document.getElementById('formTitleText').innerText = 'Cargar Nuevo Flete';
            document.getElementById('submitBtn').innerText = 'Guardar Flete';
            document.getElementById('cancelEditBtn').classList.add('hidden');
            
            document.getElementById('fecha').valueAsDate = new Date();
            const now = new Date();
            document.getElementById('hora').value = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
        }

        function renderFletes() {
            const tbody = document.getElementById('fletesTableBody');
            const cardsContainer = document.getElementById('fletesCardsContainer');
            const noData = document.getElementById('noDataMessage');
            
            tbody.innerHTML = '';
            cardsContainer.innerHTML = '';

            const textoFiltro = document.getElementById('filtroTexto').value.toLowerCase();
            const fechaFiltro = document.getElementById('filtroFecha').value;
            const movFiltro = document.getElementById('filtroMovimiento').value;

            const filtered = fletesData.filter(item => {
                const matchTexto = (item.nroViaje || '').toLowerCase().includes(textoFiltro) ||
                                   (item.producto || '').toLowerCase().includes(textoFiltro) ||
                                   (item.nroFactura || '').toLowerCase().includes(textoFiltro);
                const matchFecha = fechaFiltro ? item.fecha === fechaFiltro : true;
                const matchMov = movFiltro ? item.movimiento === movFiltro : true;
                return matchTexto && matchFecha && matchMov;
            });

            if (filtered.length === 0) {
                noData.classList.remove('hidden');
                return;
            } else {
                noData.classList.add('hidden');
            }

            filtered.forEach(item => {
                const movBadge = item.movimiento === 'Salida' 
                    ? '<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full font-medium text-xs">Salida 📤</span>'
                    : '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded-full font-medium text-xs">Entrada 📥</span>';

                // --- 1. RENDER PARA COMPUTADORA (TABLA) ---
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/80 transition text-sm";

                let adminColsHtml = '';
                if (isAdmin()) {
                    const badgePago = item.estadoPago === 'Pagado'
                        ? '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-medium text-xs">Pagado ✅</span>'
                        : '<span class="bg-orange-100 text-orange-800 px-2 py-0.5 rounded-full font-medium text-xs">Pendiente ⏳</span>';
                    
                    adminColsHtml = `
                        <td class="p-3 font-semibold text-emerald-700">$ ${(item.tarifa || 0).toLocaleString('es-AR', {minimumFractionDigits: 2})}</td>
                        <td class="p-3">${badgePago}</td>
                    `;
                }

                tr.innerHTML = `
                    <td class="p-3 text-slate-600">
                        <div class="font-medium text-slate-800">${item.fecha}</div>
                        <div class="text-[11px] text-slate-400">${item.hora} hs</div>
                    </td>
                    <td class="p-3">${movBadge}</td>
                    <td class="p-3">
                        <div class="font-bold text-slate-800">Viaje #${item.nroViaje}</div>
                        <div class="text-[11px] text-slate-500">Remito: ${item.nroFactura}</div>
                    </td>
                    <td class="p-3 font-medium text-slate-700">${item.producto}</td>
                    ${adminColsHtml}
                    <td class="p-3 text-slate-600 font-medium">${item.usuario}</td>
                    <td class="p-3 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <button onclick="editFlete('${item.id}')" title="Editar" class="p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition">✏️</button>
                            <button onclick="deleteFlete('${item.id}')" title="Eliminar" class="p-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg transition">🗑️</button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);

                // --- 2. RENDER PARA CELULAR (TARJETAS) ---
                const card = document.createElement('div');
                card.className = "bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2 text-sm";

                let adminCardHtml = '';
                if (isAdmin()) {
                    const badgePagoCard = item.estadoPago === 'Pagado'
                        ? '<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-medium text-xs">Pagado ✅</span>'
                        : '<span class="bg-orange-100 text-orange-800 px-2 py-0.5 rounded-full font-medium text-xs">Pendiente ⏳</span>';
                    
                    adminCardHtml = `
                        <div class="flex justify-between items-center pt-2 border-t border-slate-200 text-xs">
                            <span class="text-slate-500 font-medium">Tarifa / Estado:</span>
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-emerald-700">$ ${(item.tarifa || 0).toLocaleString('es-AR', {minimumFractionDigits: 2})}</span>
                                ${badgePagoCard}
                            </div>
                        </div>
                    `;
                }

                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="font-bold text-slate-900">Viaje #${item.nroViaje}</span>
                            <span class="text-xs text-slate-400 block">${item.fecha} - ${item.hora} hs</span>
                        </div>
                        <div class="flex items-center gap-2">
                            ${movBadge}
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-xs text-slate-600 pt-1">
                        <div><span class="font-medium">Remito:</span> ${item.nroFactura}</div>
                        <div><span class="font-medium">Producto:</span> ${item.producto}</div>
                    </div>
                    <div class="text-xs text-slate-500">
                        <span class="font-medium">Cargado por:</span> ${item.usuario}
                    </div>
                    ${item.comentario && item.comentario !== '-' ? `<div class="text-xs bg-white p-2 rounded-lg border border-slate-200 text-slate-600"><span class="font-medium">Comentario:</span> ${item.comentario}</div>` : ''}
                    ${adminCardHtml}
                    <div class="flex justify-end gap-2 pt-2 border-t border-slate-200">
                        <button onclick="editFlete('${item.id}')" class="px-3 py-1 bg-white border border-slate-300 text-slate-700 rounded-lg text-xs font-medium shadow-xs">Editar ✏️</button>
                        <button onclick="deleteFlete('${item.id}')" class="px-3 py-1 bg-red-50 border border-red-200 text-red-600 rounded-lg text-xs font-medium shadow-xs">Eliminar 🗑️</button>
                    </div>
                `;
                cardsContainer.appendChild(card);
            });
        }

        function updateKPIs() {
            if (!isAdmin()) return;

            const totalViajes = fletesData.length;
            let montoTotal = 0;
            let totalPagado = 0;
            let totalPendiente = 0;

            fletesData.forEach(item => {
                const tarifa = parseFloat(item.tarifa) || 0;
                montoTotal += tarifa;
                if (item.estadoPago === 'Pagado') {
                    totalPagado += tarifa;
                } else {
                    totalPendiente += tarifa;
                }
            });

            document.getElementById('kpiTotalViajes').innerText = totalViajes;
            document.getElementById('kpiMontoTotal').innerText = `$ ${montoTotal.toLocaleString('es-AR', {minimumFractionDigits: 2})}`;
            document.getElementById('kpiTotalPagado').innerText = `$ ${totalPagado.toLocaleString('es-AR', {minimumFractionDigits: 2})}`;
            document.getElementById('kpiTotalPendiente').innerText = `$ ${totalPendiente.toLocaleString('es-AR', {minimumFractionDigits: 2})}`;
        }

        function editFlete(id) {
            const item = fletesData.find(f => f.id === id);
            if (!item) return;

            editingId = item.id;
            document.getElementById('fecha').value = item.fecha;
            document.getElementById('hora').value = item.hora;
            document.getElementById('nroViaje').value = item.nroViaje;
            document.getElementById('nroFactura').value = item.nroFactura;
            document.getElementById('producto').value = item.producto;
            document.getElementById('comentario').value = item.comentario;
            
            const radios = document.querySelectorAll('input[name="movimiento"]');
            radios.forEach(r => {
                if (r.value === item.movimiento) r.checked = true;
            });

            if (isAdmin()) {
                document.getElementById('tarifa').value = item.tarifa || '';
                document.getElementById('estadoPago').value = item.estadoPago || 'Pendiente';
            }

            document.getElementById('formTitleText').innerText = `Editando Viaje #${item.nroViaje}`;
            document.getElementById('submitBtn').innerText = 'Actualizar Flete';
            document.getElementById('cancelEditBtn').classList.remove('hidden');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        async function deleteFlete(id) {
            if (confirm("¿Estás segura de que querés eliminar este registro de flete?")) {
                try {
                    if (window.firebaseModules && db) {
                        const { doc, deleteDoc } = window.firebaseModules;
                        await deleteDoc(doc(db, "fletes_nuevasemilla", id));
                    } else {
                        fletesData = fletesData.filter(f => f.id !== id);
                        saveLocalStorageFallback();
                        renderFletes();
                        updateKPIs();
                    }
                } catch (error) {
                    console.error("Error al eliminar:", error);
                    alert("No se pudo eliminar el registro.");
                }
            }
        }

        function exportToExcel() {
            const user = getCurrentUser();
            const admin = isAdmin();

            const dataToExport = fletesData.map(item => {
                const base = {
                    "Fecha": item.fecha,
                    "Hora": item.hora,
                    "Movimiento": item.movimiento,
                    "N° Viaje": item.nroViaje,
                    "N° Factura / Remito": item.nroFactura,
                    "Producto": item.producto,
                    "Comentario": item.comentario,
                    "Cargado por": item.usuario
                };

                if (admin) {
                    base["Tarifa ($)"] = item.tarifa || 0;
                    base["Estado de Pago"] = item.estadoPago || 'Pendiente';
                }

                return base;
            });

            const worksheet = XLSX.utils.json_to_sheet(dataToExport);
            const workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "Fletes Nueva Semilla");
            XLSX.writeFile(workbook, `Fletes_NuevaSemilla_${new Date().toISOString().slice(0,10)}.xlsx`);
        }
    </script>
</body>
</html>
