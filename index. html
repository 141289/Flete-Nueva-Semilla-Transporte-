<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nueva Semilla - Control de Fletes</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SheetJS para Excel -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <!-- Chart.js para gráficos -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; background-color: #f8fafc; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- ENCABEZADO Y HEADER -->
  <header class="bg-emerald-900 text-white shadow-md sticky top-0 z-30 border-b-4 border-amber-500">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-col sm:flex-row justify-between items-center gap-3">
      <div class="flex items-center gap-3">
        <div class="bg-white p-2 rounded-xl text-emerald-900 font-black text-xl shadow-sm flex items-center justify-center">
          🌱
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-tight">Nueva Semilla Transporte S.A.</h1>
          <p class="text-xs text-emerald-200">Control de Fletes y Logística</p>
        </div>
      </div>

      <!-- Selector de Usuario Activo -->
      <div class="flex items-center gap-2 bg-emerald-800/80 px-3 py-1.5 rounded-lg border border-emerald-600/50 text-sm">
        <i class="fa-solid fa-user-circle text-emerald-200 text-lg"></i>
        <span class="text-xs text-emerald-200">Usuario:</span>
        <select id="userSelector" onchange="changeUser(this.value)" class="bg-emerald-900 text-white font-semibold text-sm outline-none cursor-pointer px-2 py-1 rounded border border-emerald-700">
          <option value="Victoria">Victoria</option>
          <option value="Judit">Judit</option>
          <option value="Mauricio">Mauricio</option>
          <option value="Cristian">Cristian</option>
          <option value="Franco">Franco</option>
        </select>
      </div>
    </div>
  </header>

  <!-- CONTENIDO PRINCIPAL -->
  <main class="max-w-7xl mx-auto px-4 py-6 flex-grow w-full space-y-6">

    <!-- MÉTRICAS Y RESUMEN -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-slate-500 uppercase">Total Viajes / Facturado</p>
          <h3 id="statTotal" class="text-2xl font-bold text-slate-900 mt-1">$0,00</h3>
        </div>
        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
          <i class="fa-solid fa-truck"></i>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-slate-500 uppercase">Pendiente de Pago</p>
          <h3 id="statPending" class="text-2xl font-bold text-amber-600 mt-1">$0,00</h3>
        </div>
        <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
          <i class="fa-solid fa-clock"></i>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-slate-500 uppercase">Total Pagado</p>
          <h3 id="statPaid" class="text-2xl font-bold text-emerald-600 mt-1">$0,00</h3>
        </div>
        <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
          <i class="fa-solid fa-check-circle"></i>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-slate-500 uppercase">Cant. Registros</p>
          <h3 id="statCount" class="text-2xl font-bold text-slate-700 mt-1">0</h3>
        </div>
        <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-bold">
          <i class="fa-solid fa-file-invoice"></i>
        </div>
      </div>
    </div>

    <!-- BARRA DE ACCIONES Y BOTONES -->
    <div class="flex flex-wrap items-center justify-between gap-3 bg-white p-4 rounded-xl shadow-sm border border-slate-200">
      <div class="flex flex-wrap gap-2">
        <button onclick="openFormModal()" class="bg-emerald-700 hover:bg-emerald-800 text-white font-medium px-4 py-2 rounded-lg text-sm transition flex items-center gap-2 shadow-sm cursor-pointer">
          <i class="fa-solid fa-plus"></i> Cargar Nuevo Flete
        </button>
        <button onclick="openImportModal()" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-300 font-medium px-4 py-2 rounded-lg text-sm transition flex items-center gap-2 cursor-pointer">
          <i class="fa-solid fa-file-excel"></i> Importar Excel
        </button>
      </div>

      <div class="flex flex-wrap gap-2">
        <button id="btnDeleteSelected" onclick="deleteSelectedInvoices()" class="hidden bg-rose-600 hover:bg-rose-700 text-white font-medium px-3 py-2 rounded-lg text-sm transition flex items-center gap-1.5 shadow-sm cursor-pointer">
          <i class="fa-solid fa-trash"></i> Eliminar Selección (<span id="selectedCount">0</span>)
        </button>
        <button onclick="exportToExcel()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-3 py-2 rounded-lg text-sm transition flex items-center gap-1.5 cursor-pointer">
          <i class="fa-solid fa-download"></i> Exportar Excel
        </button>
        <button onclick="backupDatabase()" class="bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-medium px-3 py-2 rounded-lg text-sm transition flex items-center gap-1.5 cursor-pointer" title="Guardar copia de seguridad">
          <i class="fa-solid fa-cloud-arrow-down"></i> Respaldo
        </button>
        <button onclick="document.getElementById('backupFileInput').click()" class="bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-medium px-3 py-2 rounded-lg text-sm transition flex items-center gap-1.5 cursor-pointer" title="Restaurar copia de seguridad">
          <i class="fa-solid fa-cloud-arrow-up"></i> Restaurar
        </button>
        <input type="file" id="backupFileInput" accept=".json" onchange="restoreDatabase(event)" class="hidden">
      </div>
    </div>

    <!-- FILTROS Y BÚSQUEDA -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <input type="text" id="filterSearch" oninput="applyFilters()" placeholder="Buscar viaje o producto..." class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
        
        <select id="filterStatus" onchange="applyFilters()" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
          <option value="">Todos los Estados</option>
          <option value="Pendiente">Pendiente</option>
          <option value="Pagada">Pagada</option>
          <option value="Vencida">Vencida</option>
        </select>

        <select id="filterCategory" onchange="applyFilters()" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
          <option value="">Todos los Productos</option>
          <option value="Soja">Soja</option>
          <option value="Maíz">Maíz</option>
          <option value="Trigo">Trigo</option>
          <option value="Girasol">Girasol</option>
          <option value="Otro">Otro</option>
        </select>

        <input type="date" id="filterDateFrom" onchange="applyFilters()" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
        <input type="date" id="filterDateTo" onchange="applyFilters()" class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
      </div>
    </div>

    <!-- TABLA DE REGISTROS (PC) Y TARJETAS (CELULAR) -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="hidden md:block overflow-x-auto custom-scrollbar">
        <table class="w-full text-left text-sm text-slate-600">
          <thead class="bg-slate-50 text-xs text-slate-500 uppercase border-b border-slate-200">
            <tr>
              <th class="p-4 w-10">
                <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll(this.checked)" class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 w-4 h-4 cursor-pointer">
              </th>
              <th class="p-4">Fecha / Hora</th>
              <th class="p-4">N° Viaje / Remito</th>
              <th class="p-4">Producto</th>
              <th class="p-4">Tarifa ($)</th>
              <th class="p-4">Estado</th>
              <th class="p-4">Usuario</th>
              <th class="p-4 text-center">Acciones</th>
            </tr>
          </thead>
          <tbody id="invoicesTableBody" class="divide-y divide-slate-100">
            <!-- Filas dinámicas -->
          </tbody>
        </table>
      </div>

      <!-- Vista Tarjetas Móvil -->
      <div id="invoicesCardsContainer" class="md:hidden p-4 space-y-3">
        <!-- Tarjetas dinámicas para celular -->
      </div>

      <div id="emptyState" class="hidden p-8 text-center text-slate-400">
        <i class="fa-solid fa-folder-open text-4xl mb-2"></i>
        <p>No se encontraron registros de fletes.</p>
      </div>
    </div>

  </main>

  <!-- MODAL: AGREGAR / EDITAR FLETE -->
  <div id="formModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-xl w-full p-6 space-y-4 max-h-[90vh] overflow-y-auto custom-scrollbar">
      <div class="flex justify-between items-center border-b pb-3">
        <h3 id="formModalTitle" class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <i class="fa-solid fa-truck text-emerald-700"></i> Registrar Flete
        </h3>
        <button onclick="closeFormModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
      </div>

      <form id="invoiceForm" onsubmit="saveInvoice(event)" class="space-y-4 text-sm">
        <input type="hidden" id="invoiceId">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">N° de Viaje *</label>
            <input type="text" id="invoiceNumber" required placeholder="Ej: 00142" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Producto *</label>
            <select id="category" required class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
              <option value="Soja">Soja</option>
              <option value="Maíz">Maíz</option>
              <option value="Trigo">Trigo</option>
              <option value="Girasol">Girasol</option>
              <option value="Otro">Otro</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Fecha *</label>
            <input type="date" id="issueDate" required class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Hora *</label>
            <input type="time" id="dueDate" required class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Tarifa ($) *</label>
            <input type="number" step="0.01" id="amount" required placeholder="0.00" class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500 font-semibold text-emerald-800">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Estado de Pago *</label>
            <select id="status" required class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500 font-medium">
              <option value="Pendiente">Pendiente</option>
              <option value="Pagada">Pagada</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Observaciones / Comentarios</label>
          <textarea id="supplier" rows="2" placeholder="Detalle del viaje..." class="w-full border border-slate-300 rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t">
          <button type="button" onclick="closeFormModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-medium rounded-lg cursor-pointer">Cancelar</button>
          <button type="submit" class="px-5 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-medium rounded-lg shadow-sm cursor-pointer">Guardar Flete</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: IMPORTAR EXCEL -->
  <div id="importModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 space-y-4">
      <div class="flex justify-between items-center border-b pb-3">
        <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <i class="fa-solid fa-file-excel text-emerald-700"></i> Importar Fletes
        </h3>
        <button onclick="closeImportModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
      </div>
      <p class="text-xs text-slate-500">Subí un archivo de Excel (.xlsx) con los datos de los fletes.</p>
      
      <div class="border-2 border-dashed border-slate-300 rounded-xl p-6 text-center space-y-3">
        <i class="fa-solid fa-cloud-arrow-up text-3xl text-emerald-700"></i>
        <input type="file" id="excelFileInput" accept=".xlsx, .xls, .csv" class="w-full text-xs text-slate-500 file:mx-auto file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <button onclick="closeImportModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm font-medium rounded-lg cursor-pointer">Cancelar</button>
        <button onclick="processExcelImport()" class="px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-medium rounded-lg cursor-pointer">Importar</button>
      </div>
    </div>
  </div>

  <!-- LÓGICA JAVASCRIPT ROBUSTA -->
  <script>
    let invoices = JSON.parse(localStorage.getItem('ns_fletes') || '[]');
    let currentUser = localStorage.getItem('ns_current_user') || 'Victoria';

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('userSelector').value = currentUser;
      renderInvoices();
      updateStats();

      const today = new Date().toISOString().split('T')[0];
      document.getElementById('issueDate').value = today;
      const now = new Date();
      document.getElementById('dueDate').value = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    });

    function changeUser(user) {
      currentUser = user;
      localStorage.setItem('ns_current_user', currentUser);
    }

    function openFormModal(editId = null) {
      document.getElementById('formModal').classList.remove('hidden');
      if (editId) {
        document.getElementById('formModalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square text-emerald-700"></i> Editar Flete';
        const inv = invoices.find(i => i.id === editId);
        if (inv) {
          document.getElementById('invoiceId').value = inv.id;
          document.getElementById('invoiceNumber').value = inv.invoiceNumber;
          document.getElementById('category').value = inv.category;
          document.getElementById('issueDate').value = inv.issueDate;
          document.getElementById('dueDate').value = inv.dueDate;
          document.getElementById('amount').value = inv.amount;
          document.getElementById('status').value = inv.status;
          document.getElementById('supplier').value = inv.supplier;
        }
      } else {
        document.getElementById('formModalTitle').innerHTML = '<i class="fa-solid fa-truck text-emerald-700"></i> Registrar Flete';
        document.getElementById('invoiceForm').reset();
        document.getElementById('invoiceId').value = '';
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('issueDate').value = today;
        const now = new Date();
        document.getElementById('dueDate').value = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      }
    }

    function closeFormModal() { document.getElementById('formModal').classList.add('hidden'); }
    function openImportModal() { document.getElementById('importModal').classList.remove('hidden'); }
    function closeImportModal() { document.getElementById('importModal').classList.add('hidden'); }

    function saveInvoice(e) {
      e.preventDefault();
      const id = document.getElementById('invoiceId').value || '_' + Math.random().toString(36).substr(2, 9);
      
      const invoiceData = {
        id,
        invoiceNumber: document.getElementById('invoiceNumber').value,
        category: document.getElementById('category').value,
        issueDate: document.getElementById('issueDate').value,
        dueDate: document.getElementById('dueDate').value,
        amount: parseFloat(document.getElementById('amount').value) || 0,
        status: document.getElementById('status').value,
        supplier: document.getElementById('supplier').value || '-',
        user: currentUser
      };

      const index = invoices.findIndex(i => i.id === id);
      if (index >= 0) {
        invoices[index] = invoiceData;
      } else {
        invoices.unshift(invoiceData);
      }

      saveAndRefresh();
      closeFormModal();
    }

    function saveAndRefresh() {
      localStorage.setItem('ns_fletes', JSON.stringify(invoices));
      renderInvoices();
      updateStats();
    }

    function renderInvoices() {
      const tbody = document.getElementById('invoicesTableBody');
      const cardsContainer = document.getElementById('invoicesCardsContainer');
      const emptyState = document.getElementById('emptyState');
      
      tbody.innerHTML = '';
      cardsContainer.innerHTML = '';

      const filtered = getFilteredInvoices();

      if (filtered.length === 0) {
        emptyState.classList.remove('hidden');
        return;
      } else {
        emptyState.classList.add('hidden');
      }

      filtered.forEach(inv => {
        const statusBadge = inv.status === 'Pagada' 
          ? '<span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">Pagada</span>'
          : '<span class="px-2.5 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-bold">Pendiente</span>';
        
        const fmtAmount = Number(inv.amount).toLocaleString('es-AR', { style: 'currency', currency: 'ARS' });

        // Fila PC
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50 transition border-b border-slate-100";
        tr.innerHTML = `
          <td class="p-4"><input type="checkbox" value="${inv.id}" onchange="updateSelectedCount()" class="row-checkbox rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 w-4 h-4 cursor-pointer"></td>
          <td class="p-4 text-xs">
            <div class="font-medium text-slate-700">${inv.issueDate}</div>
            <div class="text-slate-400">${inv.dueDate} hs</div>
          </td>
          <td class="p-4 font-bold text-slate-800">Viaje #${inv.invoiceNumber}</td>
          <td class="p-4"><span class="px-2.5 py-1 bg-slate-100 rounded-full text-xs font-medium text-slate-700">${inv.category}</span></td>
          <td class="p-4 font-bold text-emerald-800">${fmtAmount}</td>
          <td class="p-4">${statusBadge}</td>
          <td class="p-4 text-xs text-slate-600 font-medium">${inv.user}</td>
          <td class="p-4 text-center space-x-2">
            <button onclick="openFormModal('${inv.id}')" title="Editar" class="text-slate-500 hover:text-blue-600 cursor-pointer"><i class="fa-solid fa-pen"></i></button>
            <button onclick="deleteInvoice('${inv.id}')" title="Eliminar" class="text-slate-500 hover:text-rose-600 cursor-pointer"><i class="fa-solid fa-trash"></i></button>
          </td>
        `;
        tbody.appendChild(tr);

        // Tarjeta Móvil
        const card = document.createElement('div');
        card.className = "bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-2";
        card.innerHTML = `
          <div class="flex justify-between items-start">
            <div class="flex items-center gap-2">
              <input type="checkbox" value="${inv.id}" onchange="updateSelectedCount()" class="row-checkbox rounded border-slate-300 text-emerald-600 w-4 h-4">
              <div>
                <h4 class="font-bold text-slate-900">Viaje #${inv.invoiceNumber}</h4>
                <p class="text-xs text-slate-400">${inv.issueDate} - ${inv.dueDate} hs</p>
              </div>
            </div>
            <div>${statusBadge}</div>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs py-1 border-y border-slate-100 text-slate-600">
            <div><span class="text-slate-400">Producto:</span> ${inv.category}</div>
            <div class="font-bold text-emerald-800">${fmtAmount}</div>
          </div>
          <div class="flex justify-between items-center pt-1">
            <span class="text-[11px] text-slate-400">Por: ${inv.user}</span>
            <div class="space-x-3 text-sm">
              <button onclick="openFormModal('${inv.id}')" class="text-slate-600 hover:text-blue-600"><i class="fa-solid fa-pen"></i></button>
              <button onclick="deleteInvoice('${inv.id}')" class="text-slate-600 hover:text-rose-600"><i class="fa-solid fa-trash"></i></button>
            </div>
          </div>
        `;
        cardsContainer.appendChild(card);
      });
    }

    function applyFilters() { renderInvoices(); }

    function getFilteredInvoices() {
      const search = document.getElementById('filterSearch').value.toLowerCase();
      const status = document.getElementById('filterStatus').value;
      const category = document.getElementById('filterCategory').value;
      const dateFrom = document.getElementById('filterDateFrom').value;
      const dateTo = document.getElementById('filterDateTo').value;

      return invoices.filter(inv => {
        const matchSearch = inv.invoiceNumber.toLowerCase().includes(search) || inv.category.toLowerCase().includes(search);
        const matchStatus = status ? inv.status === status : true;
        const matchCategory = category ? inv.category === category : true;
        const matchDateFrom = dateFrom ? inv.issueDate >= dateFrom : true;
        const matchDateTo = dateTo ? inv.issueDate <= dateTo : true;
        return matchSearch && matchStatus && matchCategory && matchDateFrom && matchDateTo;
      });
    }

    function updateStats() {
      let total = 0, pending = 0, paid = 0;
      invoices.forEach(inv => {
        const amt = Number(inv.amount) || 0;
        total += amt;
        if (inv.status === 'Pagada') paid += amt;
        else pending += amt;
      });

      document.getElementById('statTotal').textContent = total.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' });
      document.getElementById('statPending').textContent = pending.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' });
      document.getElementById('statPaid').textContent = paid.toLocaleString('es-AR', { style: 'currency', currency: 'ARS' });
      document.getElementById('statCount').textContent = invoices.length;
    }

    function toggleSelectAll(checked) {
      document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = checked);
      updateSelectedCount();
    }

    function updateSelectedCount() {
      const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
      const btn = document.getElementById('btnDeleteSelected');
      document.getElementById('selectedCount').textContent = checkedCount;
      if (checkedCount > 0) btn.classList.remove('hidden');
      else btn.classList.add('hidden');
    }

    function deleteInvoice(id) {
      if (confirm("¿Estás segura de eliminar este registro?")) {
        invoices = invoices.filter(i => i.id !== id);
        saveAndRefresh();
      }
    }

    function deleteSelectedInvoices() {
      const selectedIds = Array.from(document.querySelectorAll('.row-checkbox:checked')).map(cb => cb.value);
      if (selectedIds.length > 0 && confirm(`¿Estás segura de eliminar los ${selectedIds.length} registros seleccionados?`)) {
        invoices = invoices.filter(i => !selectedIds.includes(i.id));
        saveAndRefresh();
        document.getElementById('selectAllCheckbox').checked = false;
        updateSelectedCount();
      }
    }

    function exportToExcel() {
      const dataToExport = invoices.map(i => ({
        "N° Viaje": i.invoiceNumber,
        "Producto": i.category,
        "Fecha": i.issueDate,
        "Hora": i.dueDate,
        "Tarifa ($)": i.amount,
        "Estado": i.status,
        "Observaciones": i.supplier,
        "Registrado Por": i.user
      }));

      const worksheet = XLSX.utils.json_to_sheet(dataToExport);
      const workbook = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(workbook, worksheet, "Fletes");
      XLSX.writeFile(workbook, `Fletes_NuevaSemilla_${new Date().toISOString().slice(0,10)}.xlsx`);
    }

    function backupDatabase() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(invoices));
      const dlAnchor = document.createElement('a');
      dlAnchor.setAttribute("href", dataStr);
      dlAnchor.setAttribute("download", `backup_nuevasemilla_fletes_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(dlAnchor);
      dlAnchor.click();
      dlAnchor.remove();
    }

    function restoreDatabase(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (Array.isArray(parsed)) {
            invoices = parsed;
            saveAndRefresh();
            alert("¡Base de datos restaurada con éxito!");
          } else {
            alert("El archivo no tiene el formato correcto.");
          }
        } catch(err) {
          alert("Error al leer el archivo de respaldo.");
        }
      };
      reader.readAsText(file);
    }

    function processExcelImport() {
      const fileInput = document.getElementById('excelFileInput');
      const file = fileInput.files[0];
      if (!file) { alert("Por favor seleccioná un archivo."); return; }

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = new Uint8Array(e.target.result);
          const workbook = XLSX.read(data, { type: 'array' });
          const firstSheet = workbook.SheetNames[0];
          const rows = XLSX.utils.sheet_to_json(workbook.Sheets[firstSheet]);

          let added = 0;
          rows.forEach(r => {
            invoices.unshift({
              id: '_' + Math.random().toString(36).substr(2, 9),
              invoiceNumber: String(r['N° Viaje'] || r['Viaje'] || 'S/N'),
              category: r['Producto'] || 'Soja',
              issueDate: r['Fecha'] || new Date().toISOString().split('T')[0],
              dueDate: r['Hora'] || '12:00',
              amount: parseFloat(r['Tarifa'] || r['Monto'] || 0),
              status: r['Estado'] || 'Pendiente',
              supplier: r['Observaciones'] || '-',
              user: currentUser
            });
            added++;
          });

          saveAndRefresh();
          closeImportModal();
          alert(`¡Se importaron ${added} registros correctamente!`);
        } catch(err) {
          alert("Error al procesar el archivo Excel.");
        }
      };
      reader.readAsArrayBuffer(file);
    }
  </script>
</body>
</html>
